<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targets Revit 2025/2026 (.NET 8) and Revit 2027 (.NET 10) -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <RootNamespace>BlockToFamily</RootNamespace>
    <AssemblyName>BlockToFamily</AssemblyName>
    <!-- Set UseNuGetRevitApi=true in CI or when building without a local Revit install -->
    <UseNuGetRevitApi Condition="'$(UseNuGetRevitApi)' == ''">false</UseNuGetRevitApi>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2025</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT2027</DefineConstants>
  </PropertyGroup>

  <!-- Local Revit installation references (default when UseNuGetRevitApi is false and local DLLs exist) -->
  <ItemGroup Condition="'$(UseNuGetRevitApi)' != 'true' and Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- NuGet fallback when building in CI or without local Revit installation -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' and ('$(UseNuGetRevitApi)' == 'true' or !Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll'))">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' and ('$(UseNuGetRevitApi)' == 'true' or !Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll'))">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BlockToFamily.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Optional post-build deployment to %AppData%\Autodesk\Revit\Addins\<RevitVersion> on Windows -->
  <Target Name="DeployToRevitAddins" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(AppData)' != ''">
    <PropertyGroup>
      <RevitAddinFolder>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</RevitAddinFolder>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinFolder)" ContinueOnError="true" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)BlockToFamily.addin"
          DestinationFolder="$(RevitAddinFolder)"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
