<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-targets Revit 2025 (.NET 8) and Revit 2027 (.NET 10). -->
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AssemblyName>BlockToFamily</AssemblyName>
    <RootNamespace>BlockToFamily</RootNamespace>
    <UseNuGetRevitApi Condition="'$(UseNuGetRevitApi)' == ''">false</UseNuGetRevitApi>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <RevitVersion>2025</RevitVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RevitVersion>2027</RevitVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuGetRevitApi)' != 'true' and Exists('C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll')">
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' and ('$(UseNuGetRevitApi)' == 'true' or !Exists('C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll'))">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows' and ('$(UseNuGetRevitApi)' == 'true' or !Exists('C:\Program Files\Autodesk\Revit 2027\RevitAPI.dll'))">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BlockToFamily.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployToRevit" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(DeployToRevit)' != 'false'">
    <PropertyGroup>
      <RevitAddinsDirectory>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(RevitAddinsDirectory)" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetPath);$(TargetDir)BlockToFamily.addin"
          DestinationFolder="$(RevitAddinsDirectory)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
